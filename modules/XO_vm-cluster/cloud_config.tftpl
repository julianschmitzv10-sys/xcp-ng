#cloud-config


hostname: ${hostname}

#cloud_config_extension
${cloud_config_extension}

late-commands:
    - curtin in-target -- cloud-init clean --seed

runcmd:
  - [mkdir, -p, /mnt/guest-tools]
  - [mount, /dev/cdrom, /mnt/guest-tools]
  - [bash, /mnt/guest-tools/Linux/install.sh]
  - [umount, /dev/cdrom]
  - [rm, -rf, /mnt/guest-tools]